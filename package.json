{
  "name": "ksuite-browser",
  "productName": "kSuite Browser",
  "version": "0.4.0",
  "description": "Browser desktop con integrazione nativa di Infomaniak kSuite (kDrive, Mail, Calendar, kChat, kMeet)",
  "main": "dist/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch & electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release:check": "node scripts/check-release.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@ghostery/adblocker": "^2.18.2",
    "@ghostery/adblocker-electron-preload": "^2.18.2",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.4",
    "electron": "git+https://github.com/castlabs/electron-releases.git#v44.1.0+wvcus",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "lucide": "^1.47.0",
    "tldts": "^7.4.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.ksuitebrowser.app",
    "productName": "kSuite Browser",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "kSuite Browser",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "ksuite-browser"
        }
      },
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml",
        "application/pdf"
      ]
    },
    "artifactName": "kSuite-Browser-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "froll0",
        "repo": "kSuiteBrowser",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "Pagina web",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "role": "Viewer"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    }
  }
}
