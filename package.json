{
  "name": "velo",
  "productName": "Velo",
  "version": "0.5.0",
  "description": "Velo: browser desktop per la privacy e l'anonimato, con integrazione facoltativa dei servizi cloud Infomaniak",
  "main": "dist/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch & electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release:check": "node scripts/check-release.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-electron-preload": "^2.20.1",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "electron": "git+https://github.com/castlabs/electron-releases.git#v44.1.0+wvcus",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide": "^1.62.0",
    "tldts": "^7.4.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.froll0.velo",
    "productName": "Velo",
    "executableName": "velo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "extraResources": [
        {
          "from": "build/dictionaries",
          "to": "dictionaries",
          "filter": [
            "*.bdic"
          ]
        }
      ],
      "maintainer": "Velo",
      "icon": "build/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "velo"
        }
      },
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml",
        "application/pdf"
      ]
    },
    "artifactName": "Velo-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "froll0",
        "repo": "kSuiteBrowser",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "Pagina web",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "role": "Viewer"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterSign": "scripts/after-sign.cjs"
  }
}
